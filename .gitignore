# Python
__pycache__/
*.py[cod]
*.egg-info/
build/
dist/

# Environments and secrets
.venv*/
.env

# Tool caches and reports
.pytest_cache/
.mypy_cache/
.ruff_cache/
.coverage
.coverage.*
coverage.xml
htmlcov/

# Run data: raw logs stay local; curated results are committed elsewhere
data/raw/*.jsonl
data/processed/*
reports/figures/*
!data/raw/.gitkeep
!data/processed/.gitkeep
!reports/figures/.gitkeep
